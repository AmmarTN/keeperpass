<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6–11 Auto Backup. The remembered sign-in (flutter_secure_storage)
     is encrypted with a Keystore key that never leaves this phone, so a
     restored copy could not be read: it is not backed up (plan D10). -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
</full-backup-content>
