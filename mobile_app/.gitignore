# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Claude Code files stay on this computer
CLAUDE.md
CLAUDE.local.md
.claude/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated source is committed in this starter so a fresh copy can run before
# its first code-generation pass. These exceptions also override a parent
# repository that ignores generated Dart files.
!lib/**/*.freezed.dart
!lib/**/*.g.dart
!lib/**/*.gr.dart
!lib/**/*.config.dart
